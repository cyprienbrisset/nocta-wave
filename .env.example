# ===========================================
# WS-Flows Environment Variables
# ===========================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=wsflows
DATABASE_URL="postgresql://postgres:password@localhost:5434/wsflows?schema=public"

# Redis
REDIS_PASSWORD=password
REDIS_URL="redis://:password@localhost:6380"

# JWT Authentication
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (for credentials) - Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-min-32-chars"

# API Server
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4001/api"
# WebSocket URL for real-time monitoring (dashboard, logs streaming, alerts)
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# ===========================================
# Object Storage (MinIO/S3) - Optional
# ===========================================
# Enable to externalize large execution log data from PostgreSQL
# This significantly reduces database I/O and storage for production workloads

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"
OBJECT_STORAGE_BUCKET="wsflows-logs"
# Data larger than this threshold (in bytes) will be stored in object storage
OBJECT_STORAGE_COMPRESSION_THRESHOLD=1024
