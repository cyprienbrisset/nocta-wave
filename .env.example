# ===========================================
# WS-Flows Environment Variables
# ===========================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=wsflows
DATABASE_URL="postgresql://postgres:password@localhost:5434/wsflows?schema=public"

# Redis
REDIS_PASSWORD=password
REDIS_URL="redis://:password@localhost:6380"

# JWT Authentication
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (for credentials) - Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-min-32-chars"

# Trigger.dev (Self-Hosted)
TRIGGER_API_URL="http://localhost:4002"
TRIGGER_SECRET_KEY=""
# Trigger.dev Docker config
TRIGGER_DB_PASSWORD=trigger
TRIGGER_MAGIC_LINK_SECRET=change-me-trigger-magic-link-secret-32-chars
TRIGGER_SESSION_SECRET=change-me-trigger-session-secret-32-chars
TRIGGER_ENCRYPTION_KEY=change-me-trigger-encryption-key-32-chars
TRIGGER_WORKER_SECRET=change-me-worker-secret

# API Server
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4001/api"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"
