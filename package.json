{
  "name": "ws-flows",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source workflow orchestration platform - n8n clone",
  "author": "WS-Flows Team",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev --filter=@ws-flows/api --filter=@ws-flows/web",
    "dev:api": "turbo dev --filter=@ws-flows/api",
    "dev:web": "turbo dev --filter=@ws-flows/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:e2e:docker": "docker compose -f docker/docker-compose.test.yml up -d --wait && pnpm --filter @ws-flows/api test:e2e:setup && pnpm --filter @ws-flows/api test:e2e",
    "test:e2e:docker:down": "docker compose -f docker/docker-compose.test.yml down -v",
    "db:generate": "pnpm --filter @ws-flows/api db:generate",
    "db:migrate": "pnpm --filter @ws-flows/api db:migrate",
    "db:seed": "pnpm --filter @ws-flows/api db:seed",
    "db:studio": "pnpm --filter @ws-flows/api db:studio",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
