# =============================================================================
# WS-Flows API Dockerfile
# Multi-stage build for NestJS API with Prisma
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
FROM node:20-alpine AS deps

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY turbo.json ./

# Copy package.json files for all packages
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/nodes/package.json ./packages/nodes/

# Install dependencies
RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2: Builder
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/nodes/node_modules ./packages/nodes/node_modules

# Copy source code
COPY . .

# Build shared packages first
RUN pnpm --filter @ws-flows/shared build
RUN pnpm --filter @ws-flows/nodes build

# Generate Prisma client
RUN cd apps/api && pnpm exec prisma generate

# Build API
RUN pnpm --filter @ws-flows/api build

# Debug: show what was built
RUN echo "=== Build output ===" && ls -la apps/api/dist/ && ls -la apps/api/dist/src/ 2>/dev/null || true

# Verify build succeeded
RUN ls -la apps/api/dist/src/main.js || ls -la apps/api/dist/main.js || (echo "ERROR: Build failed - main.js not found" && exit 1)

# Debug: verify seed was compiled
RUN ls -la apps/api/dist/prisma/ 2>/dev/null || echo "Warning: dist/prisma not found"

# Use pnpm deploy to create a self-contained production bundle
RUN pnpm --filter @ws-flows/api deploy --prod /app/deploy

# Copy Prisma artifacts to deploy folder
RUN cp -r apps/api/prisma /app/deploy/prisma
RUN cp -r apps/api/dist /app/deploy/dist

# pnpm deploy creates symlinks to workspace packages, but these won't work
# in the final image since /app/packages won't exist. Remove symlinks and
# copy actual built files instead.
RUN rm -rf /app/deploy/node_modules/@ws-flows/shared \
    && rm -rf /app/deploy/node_modules/@ws-flows/nodes \
    && mkdir -p /app/deploy/node_modules/@ws-flows/shared \
    && mkdir -p /app/deploy/node_modules/@ws-flows/nodes \
    && cp -r packages/shared/dist /app/deploy/node_modules/@ws-flows/shared/ \
    && cp packages/shared/package.json /app/deploy/node_modules/@ws-flows/shared/ \
    && cp -r packages/nodes/dist /app/deploy/node_modules/@ws-flows/nodes/ \
    && cp packages/nodes/package.json /app/deploy/node_modules/@ws-flows/nodes/

# Generate Prisma client in deploy folder using the exact version (5.22.0)
# to avoid breaking changes from Prisma 7.x
RUN cd /app/deploy && npx prisma@5.22.0 generate

# -----------------------------------------------------------------------------
# Stage 3: Production Runner
# -----------------------------------------------------------------------------
FROM node:20-alpine AS runner

# Install necessary packages (openssl for Prisma compatibility)
RUN apk add --no-cache dumb-init openssl

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nestjs

WORKDIR /app

# Copy the self-contained deploy folder
COPY --from=builder --chown=nestjs:nodejs /app/deploy ./

# Copy entrypoint script
COPY --chown=nestjs:nodejs docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Set environment
ENV NODE_ENV=production
ENV PORT=3001

# Expose port
EXPOSE 3001

# Switch to non-root user
USER nestjs

# Health check (start_period long enough for migrations + seed)
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

# Start application with dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["./entrypoint.sh"]
